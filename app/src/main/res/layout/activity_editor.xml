<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000">

    <!-- Top bar: close, add clip, export -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u2715"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:padding="8dp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/addClipTopButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ Add Clip"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:padding="8dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/exportButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Export"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="#00E5C3"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

    </LinearLayout>

    <!-- Preview, with a draggable/resizable proxy box for whichever text
         overlay/sticker is active at the current playhead. Text overlays are
         baked into the video's rendered pixels via Media3 GL compositing, not
         separate Android views, so this proxy is a stand-in: the user drags/
         resizes IT, and on release the final position/size is written back
         into the overlay's data model, which the actual GL effect then reads. -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.media3.ui.PlayerView
            android:id="@+id/previewPlayerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="true" />

        <FrameLayout
            android:id="@+id/overlayProxyBox"
            android:layout_width="120dp"
            android:layout_height="60dp"
            android:background="#33FFFFFF"
            android:visibility="gone">

            <TextView
                android:id="@+id/overlayProxyText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:singleLine="true"
                android:ellipsize="end" />

            <ImageView
                android:id="@+id/overlayProxyImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <View
                android:id="@+id/overlayResizeHandle"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="bottom|end"
                android:background="#FFFFFF" />

        </FrameLayout>

    </FrameLayout>

    <!-- Compact control row: undo/redo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/undoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="\u21B6 Undo"
            android:textColor="#666666"
            android:textSize="14sp"
            android:padding="10dp" />

        <TextView
            android:id="@+id/redoButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Redo \u21B7"
            android:textColor="#666666"
            android:textSize="14sp"
            android:padding="10dp"
            android:layout_marginStart="24dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/timeLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        android:padding="2dp"
        android:text="0:00 / 0:00" />

    <ProgressBar
        android:id="@+id/exportProgressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:visibility="gone" />

    <!-- Timeline: video/text/music rows (drawn internally by TimelineView) -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#111111"
        android:scrollbars="none">

        <com.example.videoeditor.ui.TimelineView
            android:id="@+id/timelineView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </HorizontalScrollView>

    <!-- Inline "add" rows, CapCut-style -->
    <LinearLayout
        android:id="@+id/addAudioRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="#1C1C1E"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#00E5C3"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/musicTrackLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFF"
            android:text="Add audio"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/removeMusicButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove"
            android:textColor="#FF5A5A"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/addTextRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clickable="true"
        android:focusable="true"
        android:background="#1C1C1E"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:layout_marginTop="1dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textColor="#00E5C3"
            android:textSize="18sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:textColor="#FFFFFF"
            android:text="Add text" />

        <TextView
            android:id="@+id/removeTextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remove"
            android:textColor="#FF5A5A" />

    </LinearLayout>

    <!-- Contextual tool panel: shown/hidden depending on which bottom tool is tapped -->
    <LinearLayout
        android:id="@+id/toolPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="#0A0A0A">

        <LinearLayout
            android:id="@+id/editToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/copyClipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Copy" />

                <Button
                    android:id="@+id/pasteClipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="Paste" />

                <Button
                    android:id="@+id/deleteClipButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Delete" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <Button
                    android:id="@+id/toggleTransitionButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Add Crossfade to Next Clip" />

            </LinearLayout>

        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/filterToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/filterButtonContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/filterNoneButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None" />
                <Button android:id="@+id/filterGrayscaleButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B&amp;W" />
                <Button android:id="@+id/filterSepiaButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sepia" />
                <Button android:id="@+id/filterVividButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Vivid" />
                <Button android:id="@+id/filterCoolButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cool" />
                <Button android:id="@+id/filterWarmButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Warm" />
                <Button android:id="@+id/filterInvertButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Invert" />
                <Button android:id="@+id/filterNoirButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Noir" />
                <Button android:id="@+id/filterFadeButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Fade" />
                <Button android:id="@+id/filterDramaticButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dramatic" />
                <Button android:id="@+id/filterPastelButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pastel" />
                <Button android:id="@+id/filterNightButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Night" />

            </LinearLayout>

        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/effectToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/effectNoneButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="None" />
                <Button android:id="@+id/effectFlashButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Flash" />
                <Button android:id="@+id/effectShakeButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Shake" />
                <Button android:id="@+id/effectZoomInButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zoom In" />
                <Button android:id="@+id/effectZoomOutButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Zoom Out" />
                <Button android:id="@+id/effectPulseButton" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pulse" />

            </LinearLayout>

        </HorizontalScrollView>

        <HorizontalScrollView
            android:id="@+id/stickerToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:scrollbars="none"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/stickerButtonContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <LinearLayout
            android:id="@+id/captionsToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="One line per caption -- each becomes a timed subtitle, starting from the current playhead."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/captionsScriptInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top"
                android:hint="Line 1\nLine 2\nLine 3..." />

            <Button
                android:id="@+id/generateCaptionsButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Generate Captions" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/overlayToolsPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Place an image on top of the video, like picture-in-picture. Drag it on the preview to reposition, drag its corner to resize."
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/addImageOverlayButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Image Overlay" />

        </LinearLayout>

    </LinearLayout>

    <!-- Bottom icon toolbar, CapCut-style -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:background="#000000">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <LinearLayout android:id="@+id/toolEdit" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u270E" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Edit" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolAudio" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u266A" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Audio" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolText" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T" android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Text" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolFilters" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u25D1" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Filters" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolEffects" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u2728" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Effects" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolOverlay" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u25A6" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Overlay" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolCaptions" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\uD83D\uDCAC" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Captions" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolAdjust" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u2699" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Adjust" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolStickers" android:layout_width="64dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u263A" android:textColor="#FFFFFF" android:textSize="18sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Stickers" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout android:id="@+id/toolGenerateMedia" android:layout_width="72dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center" android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="\u2726 AI" android:textColor="#00E5C3" android:textSize="14sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Generate" android:textColor="#FFFFFF" android:textSize="10sp" />
            </LinearLayout>

        </LinearLayout>

    </HorizontalScrollView>

</LinearLayout>
